    "calculations": [
      {
        "id": "public-input-transforms",
        "name": "公共价格及归因输入转换",
        "formula": "复权收盘价 = 未复权收盘价 × 业务日当天或之前最近可用的有效复权因子 ÷ 已装载窗口最后有效因子；归因归母净利润 TTM 按可见报表转单季后取连续四季合计；总股本（万股）× 10000 转为股；十年国债利率（%）÷ 100 转年度小数利率。全收益基准使用供应商全收益指数点位，不由底座混入用户持仓计算。",
        "inputs": [
          {
            "id": "daily_price.close",
            "name": "未复权收盘价"
          },
          {
            "id": "adjustment_factor.adj_factor",
            "name": "业务日可用及窗口末日复权因子"
          },
          {
            "id": "income_statement.n_income_attr_p",
            "name": "已披露归母净利润"
          },
          {
            "id": "daily_basic.total_share",
            "name": "同日总股本（万股）"
          },
          {
            "id": "macro_observation.value",
            "name": "中国货币网十年国债收益率（%）"
          }
        ],
        "window": "输入包实际留存窗口，报表及利率按业务日可见时点取版",
        "version": "当前构建口径",
        "missing": "原价格转换可沿用之前的有效因子，无可用因子时系数回退为 1；factorCoverage 独立核对每日因子完整性，回退价格不能视为已核验复权。行情、基准和分红缺口保留原因，不能据空事件列表判断零分红。",
        "evidence": [
          "backend/app/portfolio/marts/portfolio.py"
        ]
      },
      {
        "id": "workbenchNtmDividendYield",
        "name": "预期股息率(未来12月·NTM)",
        "formula": "四季预测归母净利之和 ÷ 总股本 × 加权派息率 ÷ 收盘价 × 100%；每季预测 = 2 × 上年同季 − 前年同季；加权派息率 =（较早财年派息率 × 3＋较近财年派息率 × 5）÷ 8，财年派息率为每股分红 ÷ 正年度基本每股收益；累计报表先转单季，再按上年同季 × 2 − 前年同季预测；公共模型 rate（估算率）= 已核准 NTM 股息率（%）÷ 100。",
        "inputs": [
          {
            "id": "n_income_attr_p",
            "name": "已披露归母净利润"
          },
          {
            "id": "total_share",
            "name": "同日总股本"
          },
          {
            "id": "cash_div_tax",
            "name": "历史税前每股分红"
          },
          {
            "id": "basic_eps",
            "name": "正年度基本每股收益"
          },
          {
            "id": "close",
            "name": "估值日收盘价"
          }
        ],
        "window": "本年采用最新中期利润与前五年同期占比合格样本；未来十二个月采用最新已披露季度之后四季",
        "version": "v2",
        "missing": "分母非正、输入缺失、修订冲突、分红覆盖或送转基准未证实时为空；完整证据后才能确认零值",
        "evidence": [
          "docs/platform-api.md",
          "backend/app/stocks/derived/workbench_cards.py"
        ]
      }
    ],
