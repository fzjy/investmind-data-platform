# 后端数据存储类型，当前仅支持 database（PostgreSQL）。
DANG_DATA_BACKEND=database
# 新闻采集器读取的 JSON 配置文件，控制新闻源、轮询和保留策略。
DANG_NEWS_CONFIG_PATH=config/news/news-collector.json
# 后端写入、迁移及同步使用的 PostgreSQL 连接串。本机运行时填写可达地址，整套 Compose 会按下方数据库参数生成。
DANG_DATABASE_URL=
# 查询接口使用的数据库连接串，可指向只读副本。留空时沿用 DANG_DATABASE_URL。
DANG_DATABASE_READ_URL=
# Compose 初次创建 PostgreSQL 数据卷时建立的数据库名，也是容器内后端连接的库名。
DANG_POSTGRES_DB=danginvest
# Compose 首次初始化 PostgreSQL 数据卷时创建的登录用户，后端用此用户连接。
DANG_POSTGRES_USER=danginvest
# 上述 PostgreSQL 用户的初始密码。已有数据卷需同步修改库内密码才能切换。
DANG_POSTGRES_PASSWORD=danginvest-local-only
# 使用 docker-compose.local-db.yml 时，本机 127.0.0.1 映射到 PostgreSQL 的端口。
DANG_POSTGRES_PORT=5432
# 项目启动器和 Compose 对外提供后端 API 的宿主机端口。
DANG_BACKEND_PORT=8000
# 调用 Tushare 接口所用的个人令牌，需要采集 Tushare 数据时填写。
DANG_TUSHARE_TOKEN=
# Tushare 采集模式。standard 使用普通模式，vip 需要账号具备对应接口权限。
DANG_TUSHARE_MODE=standard
# standard 模式每分钟最多发出的 Tushare 请求数，按账号配额设置。
DANG_TUSHARE_STANDARD_REQUESTS_PER_MINUTE=30
# vip 模式每分钟最多发出的 Tushare 请求数，按账号配额设置。
DANG_TUSHARE_VIP_REQUESTS_PER_MINUTE=120
# Tushare 分页采集每页请求的记录数，取 1 至 5000。
DANG_TUSHARE_PAGE_SIZE=5000
# 日、周调度和股票更新判断日期时使用的 IANA 时区名。
DANG_SYNC_TIMEZONE=Asia/Shanghai
# true 启用宏观周同步。通过项目启动器运行时，此开关由 scheduled-tasks.json 的 macro 任务决定。
DANG_MACRO_SYNC_ENABLED=true
# 宏观周同步的执行日，按调度时区填写 mon 至 sun。
DANG_MACRO_SYNC_DAY_OF_WEEK=mon
# 宏观周同步在调度时区内的执行时间，按 24 小时制 HH:MM 填写。
DANG_MACRO_SYNC_TIME=09:00
# true 允许启动时检查并补跑错过的宏观同步，也用于控制 catchup-macro。
DANG_MACRO_SYNC_CATCHUP_ON_START=true
# 宏观历史观测数据的回填年数，取 1 至 30。
DANG_MACRO_HISTORY_YEARS=10
# 企业宏观指标的样本股票池，取 representative-50、custom 或 all。
DANG_MACRO_ENTERPRISE_UNIVERSE=representative-50
# 企业样本池选 custom 时填写股票池 JSON 文件路径，其他模式留空。
DANG_MACRO_ENTERPRISE_UNIVERSE_FILE=
# 企业宏观指标要求的最低样本覆盖率，取 1 至 100，80 表示有效样本至少占候选企业的 80%。
DANG_MACRO_ENTERPRISE_MIN_COVERAGE=80
# 企业宏观指标达到可用状态所需的最少有效样本数，按企业家数填写。
DANG_MACRO_ENTERPRISE_MIN_SAMPLES=5
# 计算企业宏观指标时使用的最大历史季度数，取 1 至 40。
DANG_MACRO_ENTERPRISE_MAX_QUARTERS=40
# 补采企业宏观指标输入数据时覆盖的季度数，取 1 至 8。
DANG_MACRO_ENTERPRISE_SUPPLEMENT_QUARTERS=8
# 调用 FRED 宏观数据接口时使用的 API 密钥，运行依赖该接口的任务时填写。
DANG_FRED_API_KEY=
# 宏观历史回填任务单次运行的 HTTP 请求上限，取 2 至 100 次。
DANG_MACRO_BACKFILL_REQUEST_LIMIT=12
# 指定宏观历史回填窗口的截止日期，按 YYYY-MM-DD 填写。
DANG_MACRO_BACKFILL_END=
# 国家统计局历史发布清单的 JSON 路径，留空使用 config/macro/nbs-history-releases.json。
DANG_MACRO_BACKFILL_RELEASES_FILE=
# 美国利率同步单次运行的 HTTP 请求上限，取 2 至 100 次。
DANG_MACRO_US_RATES_REQUEST_LIMIT=4
# 国家统计局宏观数据同步单次运行的 HTTP 请求上限，取 2 至 100 次。
DANG_MACRO_NBS_REQUEST_LIMIT=64
# 国家统计局月度数据增量同步时重复检查最近几个月的数据，取 1 至 18 个月。
DANG_MACRO_NBS_LOOKBACK_MONTHS=3
# Tushare 宏观数据同步单次运行的请求上限，取 6 至 100 次。
DANG_MACRO_TUSHARE_REQUEST_LIMIT=6
# FRED 宏观数据同步单次运行的请求上限，取 12 至 100 次。
DANG_MACRO_FRED_REQUEST_LIMIT=16
# 一轮宏观补采可发出的 HTTP 请求总数，取 1 至 1000 次。
DANG_MACRO_CATCHUP_REQUEST_LIMIT=100
# 股票日同步检查披露数据时向前覆盖的自然日数，含业务当天，取 1 至 31。
DANG_SYNC_DISCLOSURE_LOOKBACK_DAYS=7
# 股票每日同步在调度时区内的触发小时，取 0 至 23，与 DANG_SYNC_MINUTE 配合使用。
DANG_SYNC_HOUR=19
# 股票每日同步在指定小时内的触发分钟，取 0 至 59。
DANG_SYNC_MINUTE=0
# 股票同步使用的股票池，取 representative-50（代表股）、custom（自定义）或 all（全市场）。增量命令 sync-stock-data 仅支持代表股池。
DANG_SYNC_UNIVERSE=representative-50
# 股票同步选 custom 时填写股票池 JSON 文件路径，其他模式留空。
DANG_SYNC_UNIVERSE_FILE=
# 股票池历史回填的截止日期，运行 backfill-universe 时必须填写 YYYY-MM-DD。
DANG_BACKFILL_AS_OF=
# 股票历史回填和股票更新向前读取行情的年数，取 1 至 10。
DANG_BACKFILL_MARKET_YEARS=3
# 固定股票更新的截止日（YYYY-MM-DD）。留空时按调度时区和每日同步时间推算，指定日不能晚于该上限。
DANG_STOCK_UPDATE_AS_OF=
# 股票更新单次运行最多可发出的请求数，取 1 至 10000。
DANG_STOCK_UPDATE_MAX_REQUESTS_PER_RUN=512
# 股票更新查询截止日之后的交易日历天数，按自然日计，取 1 至 366。
DANG_STOCK_UPDATE_CALENDAR_LOOKAHEAD_DAYS=31
# true 在 update-routine 中启用股票更新，并允许按公告策略处理股票公告。
DANG_ROUTINE_STOCKS_ENABLED=true
# true 在 update-routine 中启用宏观数据更新。
DANG_ROUTINE_MACRO_ENABLED=true
# true 启用常规市场数据更新。项目启动器按 scheduled-tasks.json 的 market 开关设置调度进程。
DANG_ROUTINE_MARKET_ENABLED=false
# true 启用市场脉搏数据更新。项目启动器按 scheduled-tasks.json 的 marketPulse 开关设置调度进程。
DANG_ROUTINE_MARKET_PULSE_ENABLED=false
# true 启用证券地域数据更新。项目启动器按 scheduled-tasks.json 的 regions 开关设置调度进程。
DANG_ROUTINE_REGION_ENABLED=false
# true 启用 ETF 热力图更新。项目启动器按 scheduled-tasks.json 的 etfHeatmap 开关设置调度进程。
DANG_ROUTINE_ETF_HEATMAP_ENABLED=false
# true 启用大宗商品数据更新。项目启动器按 scheduled-tasks.json 的 commodities 开关设置调度进程。
DANG_ROUTINE_COMMODITIES_ENABLED=false
# 财务历史回填起始日期（YYYY-MM-DD），应早于或等于截止日。留空时与行情回填起始日相同。
DANG_BACKFILL_FINANCIAL_START=
# 股票池历史回填每批处理的股票数，取 1 至 100。
DANG_BACKFILL_BATCH_SIZE=10
# 同一股票池的日同步连续失败多少次后触发告警，取 1 至 100。
DANG_SYNC_FAILURE_ALERT_THRESHOLD=3
# 一次补跑最多处理多少个缺失的交易日，取 1 至 250。
DANG_SYNC_CATCHUP_MAX_DAYS=10
# 调度进程记录心跳的间隔秒数，取 10 至 3600。
DANG_SCHEDULER_HEARTBEAT_SECONDS=60
# 调度心跳超过多少秒未更新即判为超时，必须大于心跳间隔。
DANG_SCHEDULER_HEARTBEAT_TIMEOUT_SECONDS=180
# 调度器检查同步数据是否过期的间隔秒数，取 30 至 86400。
DANG_SYNC_FRESHNESS_INTERVAL_SECONDS=300
# 外部文件导入目录。Compose 将此宿主机目录以只读方式挂载到调度容器的 /imports。
DANG_EXTERNAL_IMPORT_PATH=./backend/imports
# 搜索关键词允许的最大字符数，取 1 至 128。
DANG_SEARCH_QUERY_MAX_LENGTH=64
# 搜索未指定分页大小时每页返回的记录数。
DANG_SEARCH_DEFAULT_PAGE_SIZE=20
# 搜索允许请求的最大每页记录数，取 1 至 200。
DANG_SEARCH_MAX_PAGE_SIZE=50
# 发布时允许筛选器基准股票记录减少的最大比例，取 0 至 1，0.2 表示最多减少 20%。
DANG_QUALITY_MAX_ROW_DROP_RATIO=0.2
# 发布时允许筛选器字段非空率较基准下降的最大幅度，取 0 至 1，0.2 表示下降 20 个百分点。
DANG_QUALITY_MAX_FIELD_DROP_RATIO=0.2
# 容量测试生成的股票数，取 1 至 10000。
DANG_CAPACITY_STOCK_COUNT=5000
# 容量测试每只股票模拟的交易日数，取 1 至 780。
DANG_CAPACITY_TRADING_DAYS=750
# 容量测试分批写入模拟数据时每批的记录数，取 1 至 50000。
DANG_CAPACITY_BATCH_SIZE=10000
# 容量检查对每个受测 API 的采样次数，取 1 至 100。
DANG_CAPACITY_API_SAMPLES=10
# 容量测试允许运行的最长时间，单位为秒。
DANG_CAPACITY_TIMEOUT_SECONDS=1800
# 容量测试结束后清理测试资源的超时时间，单位为秒。
DANG_CAPACITY_CLEANUP_TIMEOUT_SECONDS=30
# 容量测试判定构建耗时是否达标的上限，单位为秒。
DANG_CAPACITY_BUILD_BUDGET_SECONDS=300
# 容量测试中每个 API 的第 95 百分位响应时间上限，单位为毫秒。
DANG_CAPACITY_API_BUDGET_MS=500
# PostgreSQL 备份工具运行方式，docker 使用容器，native 使用本机安装的工具。
DANG_BACKUP_TOOL_MODE=docker
# 存放数据库备份包的目录，相对路径从项目根目录解析。
DANG_BACKUP_PATH=./backend/backups
# native 模式下 PostgreSQL 工具所在的 bin 目录，留空时从系统 PATH 查找。
DANG_BACKUP_NATIVE_BIN=
# docker 模式运行备份工具所用的 PostgreSQL 镜像，必须指定明确版本标签。
DANG_BACKUP_DOCKER_IMAGE=postgres:17-alpine
# 距上次成功备份多少天后判定应再备份，取 1 至 365 天。
DANG_BACKUP_INTERVAL_DAYS=7
# 按来源至少保留最近多少份备份，取 2 至 100，清理时还会保留最近已验证的备份。
DANG_BACKUP_KEEP_COUNT=8
# 按来源保留备份的天数，超过该期限并满足份数和验证条件后才可清理。
DANG_BACKUP_RETENTION_DAYS=56
# 数据库备份工具的超时时间，单位为秒，取 60 至 7200。
DANG_BACKUP_TIMEOUT_SECONDS=1800
# 初始化采集并发布的股票代码，用英文逗号分隔并带交易所后缀，至少填写一只。
DANG_BOOTSTRAP_SYMBOLS=600519.SH
# 初始化采集和发布的截止日期（YYYY-MM-DD），留空使用调度时区当天。
DANG_BOOTSTRAP_AS_OF=
# true 表示重新采集和发布已初始化的数据，必须同时给 app.bootstrap 命令传入 --force。
DANG_BOOTSTRAP_FORCE=false
