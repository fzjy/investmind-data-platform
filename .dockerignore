# 排除本机 JavaScript 依赖与包管理器日志。
node_modules
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*

# 排除前端构建结果、临时目录与本机 Python 环境。
.next
.tmp
temp
backend/.venv
backend/.tmp-*
**/__pycache__
**/*.pyc
backend/*.egg-info
# 测试源码、Python 打包产物、数据库备份和本机导入文件不进入构建上下文。
backend/tests
backend/build
backend/dist
backend/backups
backend/imports
data/local-admin
# 文件型密钥和数据库归档保留在宿主机。
.secrets
**/*.dump
# 排除导出、分发和测试缓存目录。
out
build
dist
**/.pytest_cache

# 排除 Git 工作历史和 Git 忽略规则。
.git
.gitignore

# 本机环境变量由部署时提供，镜像构建排除所有 .env 变体。
.env*

# 排除编辑器设置、交换文件和操作系统缓存。
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# 排除开发助手配置、本地工作树和代理指令。
.claude
.codex
.superpowers
.worktrees
**/.superpowers
**/.worktrees
.cursor
.windsurf
.gemini
.continue
.amazonq
.augment
.opencode
.aider.conf.yml
.clinerules
.windsurfrules
AGENTS.md
CLAUDE.md
GEMINI.md

# 运行镜像排除手册、研究资料和宿主机管理脚本。
docs
scripts

# 排除根目录的 Docker 辅助文件。
Dockerfile
docker-compose.yml
.dockerignore

# 排除 TypeScript 编译缓存及项目说明与许可文件。
*.tsbuildinfo
README.md
CHANGELOG.md
LICENSE
